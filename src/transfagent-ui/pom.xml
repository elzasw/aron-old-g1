<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cz.aron</groupId>
  <artifactId>transfagent</artifactId>
  <name>Transfagent UI</name>
  <version>1.0.0</version>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>6.5.0</version>
        <executions>
          <execution>
            <id>transfagent-api-typescript</id>
            <phase>generate-sources</phase>
            <goals>
                <goal>generate</goal>
            </goals>
            <configuration>
                <generatorName>typescript-fetch</generatorName>
                <inputSpec>${project.basedir}/../transfagent/src/main/resources/openapi/transfagent-api.yaml</inputSpec>
                <output>${project.basedir}/frontend/src/generated/api/main</output>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

	<profiles>
		<!-- npm -->
		<profile>
			<id>npm</id>
			<properties>
<!--
				<npm.skip>true</npm.skip>
-->
				<npm.workingDirectory>frontend</npm.workingDirectory>
				<npm.buildPath>target/static/ui/</npm.buildPath>
			</properties>
			<activation>
				<property>
					<name>release</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<skip>${npm.skip}</skip>
							<executable>npm</executable>
							<workingDirectory>${npm.workingDirectory}</workingDirectory>
						</configuration>
						<executions>
							<execution>
								<id>npm-install</id>
								<phase>validate</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<arguments>
										<argument>clean-install</argument>
										<argument>--legacy-peer-deps</argument>
									</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm-build</id>
								<phase>validate</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<environmentVariables>
										<BUILD_PATH>${npm.buildPath}</BUILD_PATH>
									</environmentVariables>
									<arguments>
										<argument>run</argument>
										<argument>build</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- web develop server -->
		<profile>
			<id>dev-start</id>
			<properties>
				<frontendServerPort>3000</frontendServerPort>
				<npm.workingDirectory>frontend</npm.workingDirectory>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<environmentVariables>
								<PORT>${frontendServerPort}</PORT>
								<BROWSER>NONE</BROWSER>
							</environmentVariables>
							<executable>npm</executable>
							<arguments>
								<argument>start</argument>
							</arguments>
							<workingDirectory>${npm.workingDirectory}</workingDirectory>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>exec</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>


</project>
